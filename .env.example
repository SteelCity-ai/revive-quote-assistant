# Private server environment only. Never use VITE_ for credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8790/v1
OPENAI_MODEL=gpt-4.1
OPENAI_ESTIMATE_MODEL=gpt-5.4-mini-2026-03-17
# Optional Realtime input transcript used for pause recovery and Jev routing.
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional: enables TypeSafe Jev intent/confidence routing for committed voice turns.
# Server-side only. Jev never prices, measures, approves, saves, or generates speech.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_VOICE_CONFIDENCE=0.65
PORTAL_API_URL=https://portal.reviverepairco.com/api/v1
# Optional: enables Google aerial roof measurement (/api/roof/measure).
# Requires the Solar API and Geocoding API enabled on the same key; billing applies per request.
GOOGLE_SOLAR_API_KEY=
# Optional: incoming Symplewyse estimates. Disabled until all required values are set.
# Use a dedicated IMAP app password or provider-approved mailbox credentials.
# TLS is required on port 993; never put mailbox credentials in browser variables.
ESTIMATE_IMAP_HOST=
ESTIMATE_IMAP_USER=mike@reviverepairco.com
ESTIMATE_IMAP_PASSWORD=
ESTIMATE_IMAP_FOLDER=INBOX
# Exact verified sender addresses, comma separated. Do not use a wildcard.
ESTIMATE_ALLOWED_SENDERS=
# Private persistent directory; production compose mounts /data/estimate-inbox.
ESTIMATE_INBOX_DIR=
# Required when NODE_ENV=production:
APP_ORIGIN=https://quote.reviverepairco.com
